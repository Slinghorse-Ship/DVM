# In die ProcessWire-.htaccess integrieren und CSP zuerst als Report-Only testen.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-src https://www.eventbrite.com; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>
<FilesMatch "(^\.env|composer\.(json|lock)|.*\.(log|sql|bak))$">
  Require all denied
</FilesMatch>